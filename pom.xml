<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.kinsleykajiva</groupId>
    <artifactId>JavaRust-Webrtc</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>JavaRust-Webrtc</name>
    <description>A high-performance, pure-Java WebRTC library backed by a native Rust engine (webrtc-rs) via the Java 25 Foreign Function &amp; Memory API.</description>
    <url>https://github.com/kinsleykajiva/java-rust-webrtc</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Kinsley Kajiva</name>
            <email>kajivakinsley@gmail.com</email>
            <organization>kinsleykajiva</organization>
            <organizationUrl>https://github.com/kinsleykajiva</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/kinsleykajiva/java-rust-webrtc.git</connection>
        <developerConnection>scm:git:ssh://github.com/kinsleykajiva/java-rust-webrtc.git</developerConnection>
        <url>https://github.com/kinsleykajiva/java-rust-webrtc</url>
    </scm>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <slf4j.version>2.0.13</slf4j.version>
        <junit.version>5.10.2</junit.version>
        <assertj.version>3.25.3</assertj.version>

        <!-- Native FFI bridge (relative to the reactor/root project) -->
        <ffi.crate.dir>${maven.multiModuleProjectDirectory}/rust-webrtc-ffi</ffi.crate.dir>
        <ffi.header>${ffi.crate.dir}/webrtc_ffi.h</ffi.header>
        <ffi.dll>${ffi.crate.dir}/target/release/rust_webrtc_ffi.dll</ffi.dll>
        <!-- Platform-specific native library artifact name (overridden per OS profile). -->
        <ffi.lib.name>rust_webrtc_ffi.dll</ffi.lib.name>
        <!-- jextract launcher (overridden per OS profile). -->
        <jextract.executable>${jextract.home}/bin/jextract</jextract.executable>
        <jextract.home>C:\Users\Kinsley\jextract-25</jextract.home>
        <generated.sources.dir>${project.build.directory}/generated-sources/jextract</generated.sources.dir>
        <javafx.version>25</javafx.version>
    </properties>

    <modules>
        <module>native</module>
        <module>library</module>
        <module>demo-code</module>
        <module>desktop</module>
        <module>demo-desktop</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Logging Facade -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Sources jar (Maven Central requirement). Declared per published module. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Javadoc jar (Maven Central requirement). Doclint disabled: generated
                     FFM bindings are not fully documented. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                    <configuration>
                        <doclint>none</doclint>
                        <failOnError>false</failOnError>
                        <quiet>true</quiet>
                        <additionalOptions>-Xdoclint:none</additionalOptions>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- GPG signing (Maven Central requirement). Passphrase is read from the
                     local ~/.m2/settings.xml server with id gpg.passphrase; never committed. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.7</version>
                    <configuration>
                        <keyname>${gpg.keyname}</keyname>
                        <passphraseServerId>gpg.passphrase</passphraseServerId>
                        <gpgArguments>
                            <arg>--pinentry-mode</arg>
                            <arg>loopback</arg>
                        </gpgArguments>
                    </configuration>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat/>
                    </java>
                </configuration>
            </plugin>

            <!-- Publishes the reactor (parent + native + library) to the Sonatype Central
                 Portal. Demo/desktop modules are excluded. Credentials come from the local
                 ~/.m2/settings.xml server with id "central". -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.8.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <waitUntil>published</waitUntil>
                    <excludeArtifacts>
                        <artifact>demo-code</artifact>
                        <artifact>demo-desktop</artifact>
                        <artifact>desktop</artifact>
                    </excludeArtifacts>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Release signing. Activate with -Prelease when deploying to Maven Central:
             mvn -Prelease clean deploy
             The signing key id lives in the local ~/.m2/settings.xml (property
             gpg.keyname in an active profile); the passphrase sits under the
             server with id gpg.passphrase. Nothing secret is stored in this repo. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Per-OS profiles select the native artifact name and the jextract
             launcher so the same reactor builds on Windows, macOS, and Linux. -->
        <profile>
            <id>platform-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <ffi.lib.name>rust_webrtc_ffi.dll</ffi.lib.name>
                <native.classifier>windows-x86_64</native.classifier>
                <jextract.executable>${jextract.home}/bin/jextract.bat</jextract.executable>
            </properties>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <ffi.lib.name>librust_webrtc_ffi.dylib</ffi.lib.name>
                <native.classifier>osx-aarch_64</native.classifier>
                <jextract.executable>${jextract.home}/bin/jextract</jextract.executable>
            </properties>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation>
                <os>
                    <name>linux</name>
                </os>
            </activation>
            <properties>
                <ffi.lib.name>librust_webrtc_ffi.so</ffi.lib.name>
                <native.classifier>linux-x86_64</native.classifier>
                <jextract.executable>${jextract.home}/bin/jextract</jextract.executable>
            </properties>
        </profile>
    </profiles>
</project>
