<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.kinsleykajiva</groupId>
        <artifactId>JavaRust-Webrtc</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>library</artifactId>
    <packaging>jar</packaging>
    <name>JavaRust-Webrtc Library</name>
    <description>High-performance WebRTC for Java: pure-Java API over a Rust core, accessed through the Java 21+ Foreign Function and Memory API.</description>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Native shared libraries for every supported platform, embedded in one jar
             (/native/<classifier>/<libname>). The loader extracts the right binary for
             the running OS at runtime. -->
        <dependency>
            <groupId>io.github.kinsleykajiva</groupId>
            <artifactId>JavaRust-Webrtc-native</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Native build pipeline: compile the Rust cdylib (cbindgen emits the C header),
                 then run jextract to generate FFM bindings from that header. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>build-rust-ffi</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${ffi.crate.dir}</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>--release</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-jextract</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${jextract.executable}</executable>
                            <arguments>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_init</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_free_string</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_config_create</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_config_add_ice_server</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_config_free</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_config_set_transport</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_config_set_port_range</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_config_set_allocator_flags</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_config_set_rtcp_forwarder</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_peer_create</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_peer_close</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_create_offer</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_create_answer</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_set_local_description</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_set_remote_description</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_description_create</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_description_sdp</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_description_type</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_description_free</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_add_transceiver</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_add_ice_candidate</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_create_data_channel</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_data_channel_set_callbacks</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_data_channel_send_text</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_data_channel_send_bytes</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_supported_codecs</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_add_transceiver_from_kind</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_add_transceiver_from_kind_with_encoding</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_get_stats</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_poll_rtcp</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_track_remote_ssrcs</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_track_remote_codec</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_track_remote_kind</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_track_remote_rid</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_track_remote_write_rtcp</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_track_remote_set_callbacks</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_track_remote_id</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_track_remote_label</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_create_track_local</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_add_track</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_write_sample</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_get_senders</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_remove_track</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_sender_get_payload_type</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_sender_get_codec</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_create_track_local_rtp</argument>
                                <argument>--include-function</argument>
                                <argument>webrtc_ffi_write_rtp</argument>
                                <argument>-t</argument>
                                <argument>io.github.kinsleykajiva.webrtc.ffm</argument>
                                <argument>--output</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>-I</argument>
                                <argument>${ffi.crate.dir}</argument>
                                <argument>${ffi.header}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Register the jextract output as a compile source root. -->
            <!-- FFM bindings are committed under src/main/java/.../ffm and regenerated
                 in place by run-jextract; CI deploy skips both exec steps with -Dexec.skip=true. -->

            <!-- Ensure the FFM native access flag is set for any in-module tests/runs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <!-- Maven Central requirements: sources and javadoc jars. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- On macOS, the cargo-built dylib must carry at least an ad-hoc code
             signature before the JVM can dlopen it inside a hardened runtime.
             This is best-effort: a failure here does not fail the build. -->
        <profile>
            <id>macos-codesign</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>codesign-dylib</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>codesign</executable>
                                    <ignoreExitCode>true</ignoreExitCode>
                                    <arguments>
                                        <argument>--force</argument>
                                        <argument>--sign</argument>
                                        <argument>-</argument>
                                        <argument>${ffi.crate.dir}/target/release/${ffi.lib.name}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
